# =============================================================================
# Tombola Innoss'B — API : variables de PRODUCTION
# =============================================================================
#
# Pour Coolify : ne déposez PAS ce fichier sur le serveur. Recopiez les
# variables dans « Application → Environment Variables ».
#
# Pour un serveur classique : `cp .env.production.example .env` puis renseigner.
#
# Trois règles :
#   1. tout ce qui est marqué [OBLIGATOIRE] n'a pas de valeur par défaut sûre ;
#   2. APP_KEY et les mots de passe sont des SECRETS — jamais dans le dépôt ;
#   3. les noms de variables sont ceux lus par Laravel 10 : ne pas les inventer.
#
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Application — [OBLIGATOIRE]
# -----------------------------------------------------------------------------
APP_NAME="Tombola Innoss'B API"
APP_ENV=production
APP_DEBUG=false
APP_KEY=                              # php artisan key:generate --show
APP_URL=https://api.tombola-innossb.cd

# -----------------------------------------------------------------------------
# 2. Journaux — [RECOMMANDÉ]
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# -----------------------------------------------------------------------------
# 3. Base de données — [OBLIGATOIRE]
# -----------------------------------------------------------------------------
# DB_HOST est l'hôte INTERNE fourni par Coolify (ex. « postgres » ou un nom de
# conteneur). « localhost » ne fonctionne PAS depuis un conteneur.
DB_CONNECTION=pgsql
DB_HOST=<hote-interne-postgres>
DB_PORT=5432
DB_DATABASE=tombola
DB_USERNAME=tombola_app
DB_PASSWORD=<mot-de-passe-fort>

# -----------------------------------------------------------------------------
# 4. Cache, sessions, files d'attente — [OBLIGATOIRE]
# -----------------------------------------------------------------------------
# Redis est utilisé pour les trois. L'image Docker embarque l'extension PHP
# « redis » — sans elle, toute route à session échoue.
#
# CACHE_DRIVER est le nom lu par Laravel 10 ; CACHE_STORE par Laravel 11+.
# Les deux sont définis pour rester correct après une montée de version.
CACHE_DRIVER=redis
CACHE_STORE=redis
CACHE_PREFIX=tombola

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=<hote-interne-redis>
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=tombola_

# -----------------------------------------------------------------------------
# 5. Port d'écoute — [OBLIGATOIRE]
# -----------------------------------------------------------------------------
# Doit correspondre au « Ports Exposes » de Coolify. L'image écoute sur PORT.
# Un écart entre les deux produit une erreur 502 au premier appel.
PORT=8000

# -----------------------------------------------------------------------------
# 6. Frontend et CORS — [OBLIGATOIRE]
# -----------------------------------------------------------------------------
# FRONTEND_URL sert à la fois aux liens sortants ET à la liste blanche CORS.
# Sans elle, le CORS retombe sur « * » (trop permissif).
FRONTEND_URL=https://tombola-innossb.cd
ADMIN_URL=https://tombola-innossb.cd/admin
# Origines supplémentaires éventuelles (préproduction), séparées par des virgules.
# CORS_ALLOWED_ORIGINS=https://preprod.tombola-innossb.cd

# -----------------------------------------------------------------------------
# 7. Mots de passe et double authentification — [OBLIGATOIRE]
# -----------------------------------------------------------------------------
# argon2id est imposé par la politique de sécurité.
HASH_DRIVER=argon2id
# true en production : le back-office exige un code TOTP.
REQUIRE_MFA_FOR_STAFF=true

MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
OTP_TTL_SECONDS=300
# Vérification DNS de l'email à l'inscription : désactivée car un incident DNS
# rejette des adresses parfaitement valides.
VERIFY_EMAIL_DNS=false

# -----------------------------------------------------------------------------
# 8. Compte administrateur initial — [RECOMMANDÉ]
# -----------------------------------------------------------------------------
# Utilisés UNIQUEMENT par `php artisan db:seed`.
# Hors environnement local, si TOMBOLA_ADMIN_PASSWORD est absent, un mot de passe
# aléatoire est généré et affiché une seule fois.
TOMBOLA_ADMIN_EMAIL=admin@tombola-innossb.cd
TOMBOLA_ADMIN_PASSWORD=<mot-de-passe-de-12-caracteres-minimum>

# -----------------------------------------------------------------------------
# 9. Passerelle de paiement Futaye — [OBLIGATOIRE]
# -----------------------------------------------------------------------------
# FUTAYE_TOKEN est un SECRET SERVEUR : il ne doit jamais atteindre le frontend.
FUTAYE_BASE_URL=https://futaye.buania.com
FUTAYE_CLIENT_ID=<code-application>
FUTAYE_TOKEN=<token-hmac>
FUTAYE_RETURN_URL=https://tombola-innossb.cd/paiement/retour
FUTAYE_TIMEOUT=20
# Renseigné uniquement si la passerelle signe ses webhooks avec un secret distinct.
# FUTAYE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# 10. Notifications — [RECOMMANDÉ]
# -----------------------------------------------------------------------------
# Canaux actifs : email, sms, whatsapp, push. SMS et WhatsApp nécessitent un
# fournisseur branché dans SendNotificationJob.
NOTIFICATION_CHANNELS=email

# Sans SMTP configuré, les notifications sont marquées « failed » (visible dans
# le back-office). Pour une démonstration, MAIL_MAILER=log évite ces échecs.
MAIL_MAILER=smtp
MAIL_HOST=<hote-smtp>
MAIL_PORT=587
MAIL_USERNAME=<utilisateur-smtp>
MAIL_PASSWORD=<mot-de-passe-smtp>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@tombola-innossb.cd
MAIL_FROM_NAME="Tombola Innoss'B"

# -----------------------------------------------------------------------------
# 11. Identité publique — [RECOMMANDÉ]
# -----------------------------------------------------------------------------
SITE_NAME="Tombola Innoss'B"
SUPPORT_EMAIL=support@tombola-innossb.cd
SUPPORT_PHONE=+243000000000

# -----------------------------------------------------------------------------
# 12. Réglages métier — [OPTIONNEL, valeurs par défaut saines]
# -----------------------------------------------------------------------------
ORDER_TTL_MINUTES=30
ORDER_MAX_PER_HOUR=20
TICKET_PREFIX=TMB
DRAW_MIN_SEED_LENGTH=8

# -----------------------------------------------------------------------------
# 13. Stockage — [OPTIONNEL]
# -----------------------------------------------------------------------------
FILESYSTEM_DISK=local
# ASSET_URL=                          # si les assets sont servis par un CDN

# =============================================================================
# À NE PAS DÉFINIR (pièges constatés)
# =============================================================================
# DB_HOST=localhost          → un conteneur ne voit pas la base sur localhost
# APP_DEBUG=true             → expose les traces d'exécution et les secrets
# REQUIRE_MFA_FOR_STAFF=false → désactive la double authentification du back-office
# CACHE_STORE seul           → ignoré par Laravel 10 (utiliser aussi CACHE_DRIVER)
# SESSION_DRIVER=file avec plusieurs réplicas → sessions non partagées
# Un PORT différent de « Ports Exposes » → erreur 502
